    creationDate: datetime.datetime
    generationStatus: GenerationStatus
    collectionFormId: CollectionFormId
    shipFromAddress: AddressDict

class GetCollectionFormHistoryResponseDict(TypedDict, total=False):
    collectionFormsHistoryRecordList: CollectionFormsHistoryRecordList
    lastRefreshedDate: str

class UnmanifestedShipmentLocationDict(TypedDict, total=False):
    address: AddressDict
    lastManifestDate: datetime.datetime

class UnmanifestedCarrierInformationDict(TypedDict, total=False):
    carrierId: CarrierId
    carrierName: CarrierName
    unmanifestedShipmentLocationList: UnmanifestedShipmentLocationList

class GetUnmanifestedShipmentsResponseDict(TypedDict, total=False):
    unmanifestedCarrierInformationList: UnmanifestedCarrierInformationList

class GetCollectionFormResponseDict(TypedDict, total=False):
    collectionsFormDocument: CollectionsFormDocumentDict

